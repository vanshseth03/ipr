import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  SafeAreaView,
  ScrollView,
  TextInput,
  TouchableOpacity,
  Alert,
  ActivityIndicator,
  Platform,
} from 'react-native';
import { useRouter } from 'expo-router';

import ClassifyWizardStep from '../../components/classify/ClassifyWizardStep';
import IngredientRow from '../../components/classify/IngredientRow';

import { useClassifyMutation } from '../../hooks/useClassifyMutation';
import { useHistoryStore } from '../../store/historyStore';
import { useChatStore } from '../../store/chatStore';
import { useSettingsStore } from '../../store/settingsStore';

export default function ClassifyScreen() {
  const router = useRouter();
  const { jurisdiction } = useSettingsStore();
  const { addItem: addHistoryItem } = useHistoryStore();
  const { addMessage } = useChatStore();
  const { classify, isPending, result } = useClassifyMutation();

  const [step, setStep] = useState(1);
  const [formulationName, setFormulationName] = useState('Ashwagandha-Curcumin Bio-Matrix');
  const [classicalReference, setClassicalReference] = useState('Charaka Samhita (Sutrasthana)');
  const [newIngredient, setNewIngredient] = useState('');
  const [ingredients, setIngredients] = useState([
    { name: 'Withania somnifera (Ashwagandha extract 10:1)' },
    { name: 'Curcuma longa (95% Curcuminoid complex)' },
    { name: 'Piper nigrum (Bio-availability enhancer)' },
  ]);
  const [iprCategory, setIprCategory] = useState('Patent Novelty & Non-Obviousness');

  const handleAddIngredient = () => {
    if (!newIngredient.trim()) return;
    setIngredients([...ingredients, { name: newIngredient.trim() }]);
    setNewIngredient('');
  };

  const handleRemoveIngredient = (index) => {
    setIngredients(ingredients.filter((_, i) => i !== index));
  };

  const handleRunClassification = async () => {
    if (ingredients.length === 0) {
      Alert.alert('No Ingredients', 'Please add at least one botanical ingredient.');
      return;
    }

    try {
      const payload = {
        formulationName,
        classicalReference,
        ingredients,
        iprCategory,
        jurisdiction,
      };

      const res = await classify(payload);

      // Save to history
      addHistoryItem({
        type: 'classify',
        title: `${formulationName} (${res.confidence || 75}% Score)`,
        summary: res.category || res.priorArtStatus,
        data: res,
      });
    } catch (err) {
      Alert.alert('Classification Error', err.message || 'Unable to classify formulation.');
    }
  };

  const handleSendToChat = () => {
    if (!result) return;
    addMessage({
      id: `msg-${Date.now()}`,
      role: 'user',
      content: `I analyzed my formulation **${result.formulationName}** under **${result.jurisdiction}** jurisdiction.\n\nResult Category: ${result.category}\nScore: ${result.confidence}%\nPrior Art: ${result.priorArtStatus}.\nHow can I enhance Section 3(p) non-obviousness?`,
    });
    router.push('/chat');
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.header}>
        <Text style={styles.headerTitle}>Formulation Classifier</Text>
        <Text style={styles.headerSubtitle}>
          Evaluate herbal synergy, Section 3(p) patent eligibility, and TKDL prior art overlap
        </Text>
      </View>

      <ScrollView contentContainerStyle={styles.scrollContent}>
        {/* Step Indicator */}
        <View style={styles.stepTabsRow}>
          {[1, 2, 3].map((s) => (
            <TouchableOpacity
              key={s}
              style={[styles.stepTab, step === s && styles.activeStepTab]}
              onPress={() => setStep(s)}
              accessibilityRole="button"
              accessibilityLabel={`Wizard Step ${s}`}
            >
              <Text style={[styles.stepTabText, step === s && styles.activeStepTabText]}>
                Step {s}
              </Text>
            </TouchableOpacity>
          ))}
        </View>

        {/* Step 1: General Info */}
        {step === 1 && (
          <ClassifyWizardStep
            step={1}
            title="Formulation & Classical Source"
            description="Enter the name of your Ayurvedic formulation and any underlying classical text reference."
          >
            <View style={styles.formGroup}>
              <Text style={styles.label}>Formulation Name</Text>
              <TextInput
                style={styles.input}
                value={formulationName}
                onChangeText={setFormulationName}
                placeholder="e.g. Ashwagandha-Curcumin Bio-Matrix"
              />
            </View>

            <View style={styles.formGroup}>
              <Text style={styles.label}>Classical Text Reference (Prior Art Source)</Text>
              <TextInput
                style={styles.input}
                value={classicalReference}
                onChangeText={setClassicalReference}
                placeholder="e.g. Charaka Samhita, Sushruta Samhita, API"
              />
            </View>

            <TouchableOpacity style={styles.nextBtn} onPress={() => setStep(2)}>
              <Text style={styles.nextBtnText}>Next: Ingredients ➔</Text>
            </TouchableOpacity>
          </ClassifyWizardStep>
        )}

        {/* Step 2: Ingredients */}
        {step === 2 && (
          <ClassifyWizardStep
            step={2}
            title="Botanical Ingredients List"
            description="Add botanical plant species, extract types, or chemical fractions."
          >
            <View style={styles.addIngRow}>
              <TextInput
                style={[styles.input, styles.flex1]}
                value={newIngredient}
                onChangeText={setNewIngredient}
                placeholder="e.g. Tinospora cordifolia extract 200mg"
                onSubmitEditing={handleAddIngredient}
              />
              <TouchableOpacity style={styles.addBtn} onPress={handleAddIngredient}>
                <Text style={styles.addBtnText}>+ Add</Text>
              </TouchableOpacity>
            </View>

            <View style={styles.ingListContainer}>
              <Text style={styles.ingListHeader}>Active Ingredients ({ingredients.length}):</Text>
              {ingredients.map((ing, idx) => (
                <View key={idx} style={styles.ingRowWrapper}>
                  <IngredientRow ingredient={ing} />
                  <TouchableOpacity
                    style={styles.removeIngBtn}
                    onPress={() => handleRemoveIngredient(idx)}
                    accessibilityRole="button"
                    accessibilityLabel="Remove ingredient"
                  >
                    <Text style={styles.removeIngText}>✕</Text>
                  </TouchableOpacity>
                </View>
              ))}
            </View>

            <View style={styles.stepNavRow}>
              <TouchableOpacity style={styles.backBtn} onPress={() => setStep(1)}>
                <Text style={styles.backBtnText}>⬅ Back</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.nextBtn} onPress={() => setStep(3)}>
                <Text style={styles.nextBtnText}>Next: IPR Category ➔</Text>
              </TouchableOpacity>
            </View>
          </ClassifyWizardStep>
        )}

        {/* Step 3: Objective */}
        {step === 3 && (
          <ClassifyWizardStep
            step={3}
            title="Regulatory & IPR Category"
            description="Select your target Intellectual Property protection goal."
          >
            <View style={styles.categoryPicker}>
              {[
                'Patent Novelty & Non-Obviousness',
                'TKDL Protection & Prior Art Clearance',
                'Geographical Indication (GI) / Ayush Mark',
                'Proprietary Medicine License',
              ].map((cat) => (
                <TouchableOpacity
                  key={cat}
                  style={[
                    styles.categoryChip,
                    iprCategory === cat && styles.selectedCategoryChip,
                  ]}
                  onPress={() => setIprCategory(cat)}
                  accessibilityRole="radio"
                  accessibilityState={{ checked: iprCategory === cat }}
                >
                  <Text
                    style={[
                      styles.categoryChipText,
                      iprCategory === cat && styles.selectedCategoryChipText,
                    ]}
                  >
                    {cat}
                  </Text>
                </TouchableOpacity>
              ))}
            </View>

            <TouchableOpacity
              style={[styles.classifyActionBtn, isPending && styles.disabledBtn]}
              onPress={handleRunClassification}
              disabled={isPending}
              accessibilityRole="button"
              accessibilityLabel="Run formulation classification"
            >
              {isPending ? (
                <ActivityIndicator color="#FFFFFF" />
              ) : (
                <Text style={styles.classifyActionBtnText}>
                  🔬 Evaluate Classification & Synergy
                </Text>
              )}
            </TouchableOpacity>
          </ClassifyWizardStep>
        )}

        {/* Classification Report Card */}
        {result && (
          <View style={styles.reportCard}>
            <View style={styles.reportHeader}>
              <Text style={styles.reportTitle}>Classification Report</Text>
              <View style={styles.scoreBadge}>
                <Text style={styles.scoreBadgeText}>{result.confidence}% Eligibility</Text>
              </View>
            </View>

            <Text style={styles.formulationTitle}>{result.formulationName}</Text>
            <Text style={styles.categoryTag}>Category: {result.category}</Text>

            <View style={styles.statusBox}>
              <Text style={styles.statusLabel}>Prior Art Assessment:</Text>
              <Text style={styles.statusText}>{result.priorArtStatus}</Text>
            </View>

            <View style={styles.section}>
              <Text style={styles.sectionTitle}>Botanical Ingredients Analysis:</Text>
              {result.ingredients?.map((ing, idx) => (
                <IngredientRow
                  key={idx}
                  ingredient={ing.name}
                  classification={ing.classification}
                  confidence={ing.confidence}
                />
              ))}
            </View>

            <View style={styles.section}>
              <Text style={styles.sectionTitle}>Strategic Recommendations:</Text>
              {result.recommendations?.map((rec, idx) => (
                <Text key={idx} style={styles.recText}>
                  • {rec}
                </Text>
              ))}
            </View>

            <TouchableOpacity style={styles.chatLinkBtn} onPress={handleSendToChat}>
              <Text style={styles.chatLinkBtnText}>
                💬 Ask Assistant How to Improve Patent Score
              </Text>
            </TouchableOpacity>
          </View>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: '#091A10',
    paddingTop: Platform.OS === 'android' ? 30 : 0,
  },
  header: {
    padding: 16,
    backgroundColor: '#112519',
    borderBottomWidth: 1,
    borderBottomColor: '#1F3C29',
